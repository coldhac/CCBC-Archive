ctive"]},{"id":"asset-6a639528ba2a4b080e94348f","url":"https://static.cipherpuzzles.com/static/images/5282405869124082b4ed306cf7181f54.webp","path":"data/assets/static.cipherpuzzles.com/static/images/5282405869124082b4ed306cf7181f54.webp","mime":"image/webp","size":21168,"sha256":"803c18e98ca8f9075ffee12d82d3836e32ce5d6446ee47c261a0200f31373b58","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-6c033027f340b524fc60f3d1","url":"https://static.cipherpuzzles.com/static/images/a2420272376a40d793888c8fe0b24483.webp","path":"data/assets/static.cipherpuzzles.com/static/images/a2420272376a40d793888c8fe0b24483.webp","mime":"image/webp","size":37204,"sha256":"69831c686009ada0aefa795bc8dc9efb8f71d103667f54d8a973da37ad055b7f","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-723fed2fa0923714b32f1536","url":"https://static.cipherpuzzles.com/static/images/b338df138e3d45b890bb1cf54d632baa.webp","path":"data/assets/static.cipherpuzzles.com/static/images/b338df138e3d45b890bb1cf54d632baa.webp","mime":"image/webp","size":57022,"sha256":"fbb3dcdf696ffea106b93e07cc5123f5b19ab7ed665fd2ff013c9dac165558df","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-a1ec11d233d87ddfc98bb3b3","url":"https://static.cipherpuzzles.com/static/images/3c3ec38372db4029bb64cbd59fcae636.webp","path":"data/assets/static.cipherpuzzles.com/static/images/3c3ec38372db4029bb64cbd59fcae636.webp","mime":"image/webp","size":26342,"sha256":"eb16ce7ad3c3db70a0e94cd76ef87018ddae6e7d2694f42d646d0edf5f2fecfb","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-ca79a2a7975b542640168485","url":"https://static.cipherpuzzles.com/static/images/08cb2fdf8a3041659982fe510b62c77e.webp","path":"data/assets/static.cipherpuzzles.com/static/images/08cb2fdf8a3041659982fe510b62c77e.webp","mime":"image/webp","size":16172,"sha256":"f4e2eda2931ec0fb2c72d42a740f9395212cf65773ae022d7481797f74710f00","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-d3e309605985c1a85b2226c8","url":"https://static.cipherpuzzles.com/static/images/fb4e6cb674f142e5acd57a08c3098654.webp","path":"data/assets/static.cipherpuzzles.com/static/images/fb4e6cb674f142e5acd57a08c3098654.webp","mime":"image/webp","size":45396,"sha256":"7ecfc2b1d3f667226a33ae1a4f5f433927407b29bbd8547e667f14ccd6b0c9bf","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-eb4282e0062f967a29c7362e","url":"https://static.cipherpuzzles.com/static/images/cd03a72454d34726b0bc519723e2e533.webp","path":"data/assets/static.cipherpuzzles.com/static/images/cd03a72454d34726b0bc519723e2e533.webp","mime":"image/webp","size":1134,"sha256":"df64d57eb13ed6f62dd111158d679f569d1c73df12fb7c6161ea26241dbec849","status":"cached","error":"","roles":["puzzle"],"contexts":["sourceMetadata"]},{"id":"asset-ecf3fafe53f5a4bd83d1a6b3","url":"https://static.cipherpuzzles.com/static/images/5aec4bc6f7114915918ac654b5c593cc.webp","path":"data/assets/static.cipherpuzzles.com/static/images/5aec4bc6f7114915918ac654b5c593cc.webp","mime":"image/webp","size":21936,"sha256":"704c7361cdd9a739af056119d2c494873455e998ecb397f293072b6e87008ab8","status":"cached","error":"","roles":["solution"],"contexts":["solution"]}]}
