1ad11c46d0f4e4a4eb3cb5de03593669392b1c32dd55e6576d13330e7","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-e193349a020ea796f1008862","url":"https://archive.cipherpuzzles.com/ccbc12/images/answer/e-1917-11.png","path":"data/assets/archive.cipherpuzzles.com/ccbc12/images/answer/e-1917-11.png","mime":"image/png","size":72659,"sha256":"1c16e395e06bd2a0e749f1428629bf65b298acb67adc028f1800c2bec5b37c60","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-f06220651b33f2ac7c052744","url":"https://archive.cipherpuzzles.com/ccbc12/images/answer/e-1917-13.png","path":"data/assets/archive.cipherpuzzles.com/ccbc12/images/answer/e-1917-13.png","mime":"image/png","size":24433,"sha256":"cfbbaed88b541b0eb71ab9c0b14b0560a80c0caa5045721b3d9afebdd64a79ff","status":"cached","error":"","roles":["solution"],"contexts":["solution"]},{"id":"asset-ffb6824b794378b0efb95f27","url":"https://archive.cipherpuzzles.com/ccbc12/images/answer/e-1917-5.png","path":"data/assets/archive.cipherpuzzles.com/ccbc12/images/answer/e-1917-5.png","mime":"image/png","size":57276,"sha256":"8be9c55a990a27d1848ab2f49f3bd722c20c3d183304062eb054bd9322f3975e","status":"cached","error":"","roles":["solution"],"contexts":["solution"]}]}
