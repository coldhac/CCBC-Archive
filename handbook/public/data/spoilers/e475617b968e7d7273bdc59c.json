-1) return \"\";\n\n            return pages.value[idx].html;\n        }\n\n        const mockBackendAnswerCheck = (pageIndex, answer) => {\n          switch(pageIndex) {\n              case 1:\n                  return answer == \"4\";\n              case 2:\n                  return answer == \"18\";\n              case 3:\n                  return answer == \"15\";\n              case 4:\n                  return answer == \"11\";\n              case 5:\n                  return answer == \"24\";\n              case 6:\n                  return answer == \"3\";\n              case 7:\n                  return answer == \"715\";\n              case 8:\n                  return answer == \"2\";\n              case 9:\n                  return answer == \"9\";\n              case 10:\n                  return answer == \"25\";\n              case 11:\n                  return answer == \"5\";\n              case 12:\n                  return answer == \"7\";\n              case 13:\n                  return answer == \"11\";\n              case 14:\n                  return answer == \"24\";\n              case 15:\n                  return answer == \"4\";\n              case 16:\n                  return answer == \"19\";\n              case 17:\n                  return answer == \"3\";\n              case 18:\n                  return answer == \"251922192417\";\n          }\n          return false;\n        }\n\n        const lastPageIndex = ref(1);\n        const feedback = ref(\"\");\n        const checkAnswer = (pageIndex) => {\n            let answer_status = mockBackendAnswerCheck(pageIndex, answer.value);\n\n            if (answer_status) {\n                globalBus.emit(\"  message\", {\n                    message: \"回答正确\",\n                    type: \"success\"\n                });\n                lastPageIndex.value = Math.max(lastPageIndex.value, pageIndex + 1);\n                currentPage.value = pageIndex + 1;\n                answer.value = \"