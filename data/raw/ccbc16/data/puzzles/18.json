  "extend_data": "{\"pid\":18,\"imgUrl\":\"2c9dc9d8db22471785d7fb068f3f81e0.svg\",\"color\":\"#000\",\"top\":\"392px\",\"left\":\"830px\",\"veryFirst\":false}",
  "extend_content": "成功解开谜题后，量子星云影响的设备恢复正常，同时从中浮现出一张碎纸片。\n\n<img src=\"https://static.cipherpuzzles.com/static/images/688e99e045ea4a628884c72229e0528e.webp\" alt=\"fragment\" style=\"max-width: 100%\" />",
  "adda": 0,
